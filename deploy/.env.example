# Braid deployment configuration — copy to .env and edit.

# Host path to the Book of Travels install (must have BepInEx + plugin with
# role=instance installed: run `scripts/setup-game.sh instance braid-connect.flightlessbirdlabs.io`).
BRAID_GAME_DIR=/srv/braid/game

# Hostname advertised to clients as the game server (Mirror TCP :50050).
# braid-connect points at this machine and has :50050 open.
BOT_PUBLIC_HOST=braid-connect.flightlessbirdlabs.io

# MariaDB credentials (change these)
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_PASSWORD=change-me

# Admin token for generating invite codes (POST /admin/invite)
BRAID_ADMIN_TOKEN=change-me-invite-token
