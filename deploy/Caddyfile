# Braid — Caddy config
# braid.flightlessbirdlabs.io      : howto site (static files from ../site)
# braid-connect.flightlessbirdlabs.io:1234 : master gRPC, plaintext h2c
#                                            (game client uses an insecure channel;
#                                             Caddy just routes HTTP/2 to the master)
# Ports 50050 (game instance) are NOT proxied here — they're published directly
# by the instance container and must be open on the host firewall.

# --- howto site ---
braid.flightlessbirdlabs.io {
	root * /srv/braid-site
	file_server
	encode gzip
}

# --- master gRPC (h2c on :1234) ---
braid-connect.flightlessbirdlabs.io:1234 {
	reverse_proxy master:1234 {
		transport http {
			versions h2c
		}
	}
}
